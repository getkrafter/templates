{
  "$schema": "../../schema/template.schema.json",
  "id": "rakaposhi",
  "name": "Rakaposhi",
  "version": "1.0.2",
  "contract": "1",
  "description": "Two-column with dark sidebar",
  "author": { "name": "Krafter", "url": "https://krafter.vercel.app" },
  "license": "MIT",
  "layout": {
    "mode": "grid",
    "regions": ["aside", "main"],
    "widths": [35, 65],
    "gap": 0,
    "defaultPlacement": {
      "tags": "aside",
      "languages": "aside"
    }
  },
  "settings": {
    "defaults": {
      "typography": {
        "pageHeading": {
          "fontSize": 16,
          "fontWeight": 700,
          "color": "accent-5"
        },
        "sectionHeading": {
          "fontSize": 10.2,
          "letterSpacing": 0,
          "textTransform": "none",
          "fontVariant": "normal",
          "color": "accent-3",
          "decoration": {
            "enabled": true,
            "borderWidth": 1,
            "borderColor": "accent-4",
            "sides": {
              "bottom": true
            }
          }
        },
        "link": {
          "color": "accent-7"
        }
      },
      "spacing": {
        "header": {
          "after": 24
        }
      },
      "color": {
        "accent": "#374151"
      },
      "header": {
        "align": "left",
        "separator": "slash",
        "icons": true
      },
      "renderDefaults": {
        "tagStyle": "list",
        "showSummaryHeading": false
      }
    },
    "locked": [
      "typography.sectionHeading.decoration.enabled",
      "typography.sectionHeading.decoration.sides.top",
      "typography.sectionHeading.decoration.sides.right",
      "typography.sectionHeading.decoration.sides.bottom",
      "typography.sectionHeading.decoration.sides.left",
      "typography.sectionHeading.decoration.borderStyle",
      "typography.sectionHeading.decoration.borderWidth",
      "typography.sectionHeading.decoration.borderColor",
      "header.separator"
    ],
    "controls": [
      {
        "type": "slider",
        "key": "sidebar-tint",
        "label": "Sidebar tint",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 22
      },
      {
        "type": "toggle",
        "key": "sidebar-custom-colors",
        "label": "Custom sidebar colours",
        "default": false
      },
      {
        "type": "color",
        "key": "sidebar-link-color",
        "label": "Sidebar link colour",
        "default": "#cfe0f0"
      },
      {
        "type": "color",
        "key": "sidebar-heading-color",
        "label": "Sidebar heading colour",
        "default": "#c0c0c0"
      }
    ]
  }
}
